<!-- 刷题页 -->
<!-- Toast -->
<view wx:if="{{toast}}" class="toast toast-{{toast.type}}">{{toast.msg}}</view>

<!-- 顶部信息 -->
<view class="header">
  <text class="logo" style="font-size:30rpx;">{{stats.done}}/{{stats.total}} {{stats.rate}}</text>
  <view class="xp-row">
    <text style="font-size:24rpx;color:#6366f1;" bindtap="onSwitchSubj" data-subj="math">📐</text>
    <text style="font-size:24rpx;color:#4ecdc4;" bindtap="onSwitchSubj" data-subj="physics">⚡</text>
    <text style="font-size:24rpx;color:#a78bfa;" bindtap="onSwitchSubj" data-subj="chemistry">🧪</text>
    <text style="font-size:24rpx;color:#f59e0b;" bindtap="onSwitchSubj" data-subj="politics">📋</text>
  </view>
</view>

<!-- 知识点横向滚动 -->
<scroll-view class="kp-scroll" scroll-x>
  <text class="kp-tag {{currentKp === 'all' ? 'active' : ''}}" data-kp="all" bindtap="onSwitchKp">📦 全部</text>
  <block wx:for="{{kpOptions}}" wx:key="id">
    <text class="kp-tag {{currentKp === item.id ? 'active' : ''}}" data-kp="{{item.id}}" bindtap="onSwitchKp">{{item.icon}} {{item.name}}</text>
  </block>
</scroll-view>

<!-- 题目列表 -->
<view wx:if="{{questions.length === 0}}" class="empty">
  <view class="empty-title">🔍 暂无题目</view>
  <text>换个知识点试试</text>
</view>

<view wx:for="{{questions}}" wx:key="id" wx:for-item="q" wx:for-index="qi" id="q-{{q.id}}">
  <view class="q-card {{answered[q.id] ? (answered[q.id].ok ? 'done-correct' : 'done-wrong') : ''}}">
    <!-- 头部 -->
    <view class="q-header">
      <view class="q-num">{{qi + 1}}</view>
      <text class="q-tag {{q.type === 'choice' ? 'choice' : q.type === 'fill' ? 'fill' : 'solution'}}">{{q.type === 'choice' ? '选择' : q.type === 'fill' ? '填空' : '解答'}}</text>
      <text style="font-size:22rpx;color:{{q.difficulty === 'easy' ? '#10b981' : q.difficulty === 'medium' ? '#f59e0b' : '#ef4444'}};">{{q.difficulty === 'easy' ? '⭐' : q.difficulty === 'medium' ? '⭐⭐' : '⭐⭐⭐'}}</text>
      <text style="font-size:22rpx;color:#9ca3af;margin-left:auto;">{{q.kp}}</text>
      <text class="star-btn" data-qid="{{q.id}}" bindtap="onToggleStar">{{marked.indexOf(q.id) >= 0 ? '⭐' : '☆'}}</text>
    </view>

    <!-- 题目文字 -->
    <view class="q-text">{{q.text}}</view>

    <!-- 选择题选项 -->
    <view wx:if="{{q.type === 'choice'}}">
      <view
        wx:for="{{q.options}}"
        wx:for-item="opt"
        wx:for-index="oi"
        wx:key="oi"
        class="opt {{answered[q.id] ? (opt === q.answer ? 'correct' : (answered[q.id].picked === opt ? 'wrong' : '')) : ''}}"
        data-qid="{{q.id}}"
        data-oidx="{{oi}}"
        bindtap="onSelectOption"
      >
        <view class="opt-letter">{{'ABCD'[oi]}}</view>
        <text>{{opt}}</text>
      </view>
    </view>

    <!-- 填空题输入 -->
    <view wx:if="{{q.type === 'fill'}}">
      <view class="fill-row" wx:if="{{!answered[q.id]}}">
        <input class="fill-input" placeholder="输入你的答案..." value="{{fill_qid[q.id] || ''}}" data-qid="{{q.id}}" bindinput="onFillInput"/>
        <button class="fill-btn" data-qid="{{q.id}}" bindtap="onSubmitFill">✓ 提交</button>
      </view>
      <view wx:if="{{answered[q.id]}}" class="fill-row">
        <input class="fill-input {{answered[q.id].ok ? 'correct' : 'wrong'}}" value="{{answered[q.id].picked}}" disabled/>
      </view>
    </view>

    <!-- 答案区域 -->
    <view style="margin-top:12rpx;">
      <button class="ans-btn" data-qid="{{q.id}}" bindtap="onToggleAns">{{showAnswers[q.id] ? '🙈 收起' : '💡 查看解析'}}</button>
      <view wx:if="{{showAnswers[q.id] || answered[q.id]}}" class="ans-content">
        <view class="ans-label">✅ 答案：{{q.answer}}</view>
        <view>{{q.explanation}}</view>
        <view wx:if="{{q.source}}" class="ans-src">📎 {{q.source}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 底部工具栏 -->
<view wx:if="{{questions.length > 0}}" class="footer-ctrls">
  <button class="ctrl-btn accent" bindtap="onRandom">🎲 随机</button>
  <button class="ctrl-btn" bindtap="onRevealAll">📖 全展开</button>
  <button class="ctrl-btn" bindtap="onSwitchKp" data-kp="all">🔄 重置筛选</button>
</view>
