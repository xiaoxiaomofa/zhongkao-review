page {
  background: linear-gradient(135deg, #e0e7ff 0%, #f0e6ff 30%, #e6f0ff 60%, #fef3e0 100%);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  min-height: 100vh;
}

.container { padding: 16rpx 24rpx; }

/* ─── Header ─── */
.header {
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.85);
}
.logo {
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.xp-row { display: flex; align-items: center; gap: 8rpx; }
.level-tag {
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  color: #fff;
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.xp-bar-wrap {
  width: 180rpx;
  height: 14rpx;
  background: #e5e7eb;
  border-radius: 7rpx;
  overflow: hidden;
}
.xp-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
  border-radius: 7rpx;
  transition: width 0.5s;
}
.xp-text { font-size: 22rpx; color: #9ca3af; }

/* ─── Subject Tabs ─── */
.tabs {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  justify-content: center;
  flex-wrap: wrap;
}
.tab {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}
.tab.active { color: #fff; transform: scale(1.05); }
.tab-math.active { background: linear-gradient(135deg, #ff6b6b, #ee5a24); }
.tab-physics.active { background: linear-gradient(135deg, #4ecdc4, #2ecc71); }
.tab-chemistry.active { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
.tab-politics.active { background: linear-gradient(135deg, #f59e0b, #fbbf24); }

/* ─── Stats ─── */
.stats {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.stat-item {
  background: rgba(255,255,255,0.8);
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* ─── Kp Tags ─── */
.kp-scroll { white-space: nowrap; padding: 12rpx 24rpx; }
.kp-tag {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 26rpx;
  color: #6b7280;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.kp-tag.active { background: #eef2ff; color: #6366f1; font-weight: 700; }

/* ─── Question Card ─── */
.q-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border-left: 6rpx solid #e5e7eb;
}
.q-card.done-correct { border-left-color: #10b981; background: #f0fdf6; }
.q-card.done-wrong { border-left-color: #ef4444; background: #fef5f5; }
.q-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.q-num {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #f1f5f9;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
}
.q-tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 16rpx; font-weight: 600; }
.q-tag.choice { background: #dbeafe; color: #2563eb; }
.q-tag.fill { background: #fef3c7; color: #d97706; }
.q-tag.solution { background: #ede9fe; color: #7c3aed; }
.q-text { font-size: 30rpx; line-height: 1.8; color: #334155; margin-bottom: 16rpx; }

/* ─── Options ─── */
.opt {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; margin-bottom: 12rpx;
  border-radius: 20rpx; border: 3rpx solid #e5e7eb;
  background: #fafbfc; font-size: 28rpx; transition: all 0.2s;
}
.opt-letter {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #e5e7eb;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 26rpx; flex-shrink: 0;
}
.opt.correct { border-color: #10b981; background: #d1fae5; }
.opt.correct .opt-letter { background: #10b981; color: #fff; }
.opt.wrong { border-color: #ef4444; background: #fee2e2; }
.opt.wrong .opt-letter { background: #ef4444; color: #fff; }

/* ─── Fill Input ─── */
.fill-row { display: flex; gap: 16rpx; align-items: center; margin-bottom: 16rpx; }
.fill-input {
  flex: 1; padding: 20rpx 24rpx; border-radius: 20rpx;
  border: 3rpx solid #e5e7eb; font-size: 28rpx; background: #fafbfc;
}
.fill-input.correct { border-color: #10b981; background: #d1fae5; }
.fill-input.wrong { border-color: #ef4444; background: #fee2e2; }
.fill-btn {
  padding: 20rpx 36rpx; border-radius: 20rpx;
  background: #6366f1; color: #fff; font-weight: 600;
  font-size: 28rpx; border: none;
}

/* ─── Answer ─── */
.ans-btn {
  padding: 12rpx 28rpx; border-radius: 28rpx;
  border: 2rpx solid #d1d5db; background: #f9fafb;
  font-size: 24rpx; color: #6b7280;
}
.ans-content {
  margin-top: 16rpx; padding: 20rpx 24rpx;
  background: #f0fdf6; border-radius: 20rpx;
  border-left: 6rpx solid #10b981;
  font-size: 26rpx; line-height: 1.7;
}
.ans-label { color: #059669; font-weight: 700; margin-bottom: 8rpx; }
.ans-src { font-size: 22rpx; color: #9ca3af; margin-top: 12rpx; }
.star-btn { font-size: 40rpx; padding: 4rpx 8rpx; background: none; border: none; }

/* ─── Controls ─── */
.controls {
  display: flex; gap: 12rpx; padding: 16rpx 24rpx;
  flex-wrap: wrap; align-items: center;
}
.ctrl-btn {
  padding: 14rpx 28rpx; border-radius: 28rpx;
  background: #fff; border: 2rpx solid #e5e7eb;
  font-size: 26rpx; font-weight: 600; color: #374151;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.ctrl-btn.accent { background: #6366f1; color: #fff; border-color: #6366f1; }

/* ─── Empty ─── */
.empty { text-align: center; padding: 100rpx 40rpx; color: #9ca3af; }
.empty-title { font-size: 36rpx; color: #374151; margin-bottom: 12rpx; }

/* ─── Toast ─── */
.toast {
  position: fixed; top: 20rpx; left: 50%; transform: translateX(-50%);
  z-index: 999; padding: 20rpx 48rpx; border-radius: 40rpx;
  font-weight: 700; font-size: 28rpx; color: #fff;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.2);
}
.toast-ok { background: #10b981; }
.toast-no { background: #ef4444; }
.toast-up { background: linear-gradient(135deg, #8b5cf6, #6366f1); }

/* ─── Footer Controls ─── */
.footer-ctrls {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; gap: 16rpx; padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.9);
  border-top: 1rpx solid #e5e7eb;
  backdrop-filter: blur(10px);
}
